  <metadata>
    <id>Hangfire.Dashboard</id>
    <version>1.0.0</version>
    <authors>abmalik.com</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://abmalik.com/</projectUrl>
    <description>A modern, customizable Hangfire Dashboard as a Razor Class Library (RCL). Provides a fully featured jobs management UI with filtering, pagination, bulk actions, real-time charts, and configurable authentication/authorization. Ships as a NuGet package targeting .NET 8, 9, and 10.</description>
    <tags>hangfire dashboard aspnetcore razor background-jobs rcl</tags>
    <repository type="git" url="https://github.com/abmalik/Hangfire.Dashboard" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Hangfire.AspNetCore" version="1.8.23" exclude="Build,Analyzers" />
        <dependency id="Hangfire.Core" version="1.8.23" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Hangfire.AspNetCore" version="1.8.23" exclude="Build,Analyzers" />
        <dependency id="Hangfire.Core" version="1.8.23" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Hangfire.AspNetCore" version="1.8.23" exclude="Build,Analyzers" />
        <dependency id="Hangfire.Core" version="1.8.23" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
      <group targetFramework="net9.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
      <group targetFramework="net10.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
